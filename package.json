{
  "name": "@page2markdown/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "bun test tests",
    "test:e2e": "node tests/e2e/extension.e2e.mjs",
    "check": "bun run typecheck && bun run lint && bun test tests && bun run build",
    "package": "bun run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "marked": "^18.0.12",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/turndown": "^5.0.5",
    "eslint": "9",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.53.1",
    "vite": "^5.4.0"
  }
}
